{
  "manifest_version": 3,
  "name": "Clicknote",
  "version": "0.4.0",
  "description": "Annotate elements on a web page and send them to your coding agent.",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "host_permissions": ["http://127.0.0.1/*"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Annotate this page for your coding agent",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["http://127.0.0.1:47823/open/*"], "js": ["opened.js"], "run_at": "document_start" }],
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+H" } } }
}
